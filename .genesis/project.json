  "assumptions": [
    {
      "id": "ASSUMPTION-7dcf2616",
      "text": "The resume attachment is not visible in the workspace. Implementation must accept a user-supplied PDF at runtime, extract professional links and sender details for confirmation, and ground every fit claim and metric in source evidence.",
      "status": "open",
      "source": "Workspace inspection, 2026-10-06",
      "recorded_at": "2026-10-06T09:41:17.512Z",
      "paths": [],
      "tags": []
    }
  ],
  "invariants": [],
  "decisions": [
    {
      "id": "DECISION-3c040385",
      "title": "MVP operating model",
      "text": "The user manually invokes Codex CLI to discover, research, match, and draft outreach for at most 20 companies per run. There is no embedded LLM API and no automatic schedule in the MVP.",
      "status": "accepted",
      "source": "User discovery interview, 2026-10-06",
      "recorded_at": "2026-10-06T09:41:16.642Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-282d4901",
      "title": "Approval and sending boundary",
      "text": "Every draft remains pending in the local dashboard until the user edits if desired and explicitly approves it. Neither Codex CLI nor ingestion may send email automatically. Approved messages are sent through Gmail.",
      "status": "accepted",
      "source": "User discovery interview, 2026-10-06",
      "recorded_at": "2026-10-06T09:41:16.796Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-ee081748",
      "title": "Targeting and contact hierarchy",
      "text": "Target fresh AI-related roles worldwide, including remote roles, at seniority inferred from the resume. For onsite roles outside the user's location, require explicit relocation or visa support. Contact early-stage founders/co-founders, medium-company CTO or engineering leaders, and large-company best-fit HR/hiring or engineering leaders.",
      "status": "accepted",
      "source": "User discovery interview, 2026-10-06",
      "recorded_at": "2026-10-06T09:41:16.971Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-18862c53",
      "title": "Verification and deduplication",
      "text": "Use public professional data and free service tiers only. Never send to an unverified address. Send at most one initial email per company; no follow-ups. Suppress the company for 90 days and allow it again only for a substantially different matching role. Replies and opt-outs override cooldown and suppress further outreach.",
      "status": "accepted",
      "source": "User discovery interview, 2026-10-06",
      "recorded_at": "2026-10-06T09:41:17.149Z",
      "paths": [],
      "tags": []
    },
    {
      "id": "DECISION-3a14fbc4",
      "title": "Storage and interface",
      "text": "Use Neon PostgreSQL as the system of record and provide CSV export. Provide a local-only web dashboard with no login. Store secrets only in .env and never expose them in source, logs, generated Markdown, or the database.",
      "status": "superseded",
      "source": "User discovery interview, 2026-10-06",
      "recorded_at": "2026-10-06T09:41:17.332Z",
      "paths": [],
      "tags": [],
      "superseded_by": "DECISION-2cf39834"
    },
    {
      "id": "DECISION-2cf39834",
      "title": "Storage and interface without CSV",
      "text": "Use Neon PostgreSQL as the sole system of record. The MVP has no CSV ingestion or export flow. Provide a local-only web dashboard with no login. Store secrets only in .env and never expose them in source, logs, generated Markdown, or the database.",
      "status": "accepted",
      "source": "User revision, 2026-10-06",
      "recorded_at": "2026-10-06T13:24:01.590Z",
      "paths": [],
      "tags": [],
      "supersedes": "DECISION-3a14fbc4"
    }
  ],
